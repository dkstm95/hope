{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hope.local/schemas/polish/receipt-v1.schema.json",
  "title": "Hope polish receipt version 1",
  "description": "Deprecated compatibility schema. The shared Polish runtime accepts this version 1 shape and returns the current record shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature",
    "version",
    "run",
    "result",
    "receiptDigest"
  ],
  "properties": {
    "feature": { "const": "polish-receipt" },
    "version": { "const": 1 },
    "run": { "$ref": "run-v2.schema.json" },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed", "status", "verificationStatus"],
      "properties": {
        "changed": { "type": "boolean" },
        "status": {
          "enum": ["revised", "no-change", "needs-alignment"]
        },
        "verificationStatus": {
          "enum": [
            "verified-in-checked-scope",
            "incomplete",
            "failed",
            "not-completed"
          ]
        }
      }
    },
    "receiptDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
