{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hope.local/schemas/sweep/plan-v1.schema.json",
  "title": "Hope sweep plan version 1",
  "description": "Structural authoring schema. The shared Sweep runtime performs the semantic, evidence, identity, and budget validation required for execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "title",
    "risk",
    "snapshot",
    "session",
    "categories",
    "candidates",
    "summary"
  ],
  "properties": {
    "version": { "const": 1 },
    "title": { "$ref": "#/$defs/text" },
    "risk": { "enum": ["low", "medium", "high"] },
    "snapshot": { "$ref": "#/$defs/snapshot" },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "state",
        "budget",
        "consideredCategoryIds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "scope": { "const": "entire-codebase" },
        "state": {
          "enum": [
            "awaiting-approval",
            "complete-with-findings",
            "complete-no-change",
            "blocked"
          ]
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximumFiles", "maximumCandidates", "maximumChanges"],
          "properties": {
            "maximumFiles": { "type": "integer", "minimum": 1 },
            "maximumCandidates": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "maximumChanges": {
              "type": "integer",
              "minimum": 1,
              "maximum": 96
            }
          }
        },
        "consideredCategoryIds": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "coverage": { "$ref": "#/$defs/coverage" },
    "categories": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "support",
          "inspection",
          "summary",
          "checks",
          "evidenceSourceIds",
          "gaps"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "support": { "enum": ["supported", "unsupported"] },
          "inspection": {
            "enum": ["checked", "partial", "not-checked", "failed"]
          },
          "summary": { "$ref": "#/$defs/text" },
          "checks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 21,
            "items": { "$ref": "#/$defs/maintenanceCheckResult" }
          },
          "evidenceSourceIds": { "$ref": "#/$defs/sourceIds" },
          "gaps": { "$ref": "#/$defs/textList" }
        }
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
        "required": ["assessment", "filesChecked", "checkedScope", "remainingGaps"],
      "properties": {
        "assessment": { "$ref": "#/$defs/text" },
        "filesChecked": {
          "description": "The exact number of distinct file sources cited by inspected maintenance checks; the runtime derives and verifies this value.",
          "type": "integer",
          "minimum": 0
        },
        "filesInInventory": {
          "description": "The exact number of file sources in the full-codebase inventory.",
          "type": "integer",
          "minimum": 0
        },
        "checkedScope": { "$ref": "#/$defs/textList" },
        "remainingGaps": { "$ref": "#/$defs/textList" }
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "categoryId",
        "checkId",
        "title",
        "targetSourceIds",
        "evidenceSourceIds",
        "behaviorImpact",
        "publicContractImpact",
        "dependencyImpact",
        "disposition",
        "reason",
        "action",
        "preview",
        "maximumChanges",
        "evidenceChecks",
        "verification",
        "gaps"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "categoryId": { "$ref": "#/$defs/id" },
        "checkId": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "targetSourceIds": {
          "allOf": [
            { "$ref": "#/$defs/sourceIds" },
            { "minItems": 1 }
          ]
        },
        "evidenceSourceIds": {
          "allOf": [
            { "$ref": "#/$defs/sourceIds" },
            { "minItems": 1 }
          ]
        },
        "behaviorImpact": {
          "description": "The proposed action's impact on intended runtime, user-visible, build, test, and release outcomes.",
          "enum": ["preserving", "changing", "uncertain"]
        },
        "publicContractImpact": {
          "description": "The proposed action's impact on supported APIs, commands, schemas, configuration, and documented promises.",
          "enum": ["preserving", "changing", "uncertain"]
        },
        "dependencyImpact": {
          "description": "The proposed action's impact on declared external package, runtime, platform, and support relationships, excluding ordinary internal import rewrites.",
          "enum": ["preserving", "changing", "uncertain"]
        },
        "disposition": { "enum": ["polish", "report-only", "handoff"] },
        "reason": { "$ref": "#/$defs/text" },
        "action": { "$ref": "#/$defs/text" },
        "preview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "patch"],
          "properties": {
            "summary": { "$ref": "#/$defs/text" },
            "patch": { "$ref": "#/$defs/text" }
          }
        },
        "maximumChanges": {
          "type": "integer",
          "minimum": 1,
          "maximum": 96
        },
        "evidenceChecks": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "detail", "sourceIds"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "status": {
                "enum": ["passed", "not-applicable", "inconclusive", "not-run"]
              },
              "detail": { "$ref": "#/$defs/text" },
              "sourceIds": { "$ref": "#/$defs/sourceIds" }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": { "enum": ["passed", "not-applicable"] }
                  },
                  "required": ["status"]
                },
                "then": {
                  "properties": { "sourceIds": { "minItems": 1 } }
                }
              }
            ]
          }
        },
        "verification": {
          "allOf": [
            { "$ref": "#/$defs/textList" },
            { "minItems": 1 }
          ]
        },
        "gaps": { "$ref": "#/$defs/textList" }
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "\\S"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "textList": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/text" }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "sourceIds": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "inspectionMode", "inventoryDigest", "fileSourceIds", "batches"],
      "properties": {
        "mode": { "const": "full-codebase" },
        "inspectionMode": {
          "enum": ["active-session", "subagent-hybrid"]
        },
        "inventoryDigest": { "$ref": "#/$defs/digest" },
        "fileSourceIds": { "$ref": "#/$defs/sourceIds" },
        "batchMergeDigest": { "$ref": "#/$defs/digest" },
        "relationshipEvidenceSourceIds": { "$ref": "#/$defs/sourceIds" },
        "relationshipIds": { "$ref": "#/$defs/sourceIds" },
        "observationIds": { "$ref": "#/$defs/sourceIds" },
        "batches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "ordinal", "fileSourceIds", "inspection", "gaps"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "ordinal": { "type": "integer", "minimum": 1 },
              "fileSourceIds": { "$ref": "#/$defs/sourceIds" },
              "inspection": {
                "enum": ["checked", "partial", "not-checked", "failed"]
              },
              "gaps": { "$ref": "#/$defs/textList" }
            }
          }
        }
      }
    },
    "maintenanceCheckResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "inspection",
        "summary",
        "evidenceSourceIds",
        "gaps"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "inspection": {
          "enum": ["checked", "partial", "not-checked", "failed"]
        },
        "summary": { "$ref": "#/$defs/text" },
        "evidenceSourceIds": { "$ref": "#/$defs/sourceIds" },
        "gaps": { "$ref": "#/$defs/textList" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capturedAt", "sources"],
      "properties": {
        "capturedAt": { "type": "string", "format": "date-time" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "label", "locator"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "kind": {
                "enum": ["conversation", "git", "file", "url", "artifact"]
              },
              "label": { "$ref": "#/$defs/text" },
              "locator": { "$ref": "#/$defs/text" },
              "revision": { "$ref": "#/$defs/text" },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "session": {
            "required": ["scope"],
            "properties": { "scope": { "const": "entire-codebase" } }
          }
        },
        "required": ["session"]
      },
      "then": { "required": ["coverage"] }
    },
    {
      "if": {
        "properties": {
          "coverage": {
            "required": ["inspectionMode"],
            "properties": {
              "inspectionMode": { "const": "subagent-hybrid" }
            }
          }
        },
        "required": ["coverage"]
      },
      "then": {
        "properties": {
          "coverage": {
            "required": [
              "batchMergeDigest",
              "relationshipEvidenceSourceIds",
              "relationshipIds",
              "observationIds"
            ]
          }
        }
      }
    }
  ]
}
