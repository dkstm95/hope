{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hope.local/schemas/sweep/session-result-v1.schema.json",
  "title": "Hope sweep session result version 1",
  "description": "Structural authoring schema. The shared Sweep runtime revalidates the embedded plan and completions, then derives complete candidate and remaining-gap coverage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "title",
    "plan",
    "planDigest",
    "completions",
    "candidateResults",
    "summary"
  ],
  "properties": {
    "version": { "const": 1 },
    "title": { "$ref": "#/$defs/text" },
    "plan": { "$ref": "plan-v1.schema.json" },
    "planDigest": { "$ref": "#/$defs/digest" },
    "completions": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "completion-v1.schema.json" }
    },
    "candidateResults": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidateId",
          "disposition",
          "status",
          "completionDigest",
          "gaps"
        ],
        "properties": {
          "candidateId": { "$ref": "#/$defs/id" },
          "disposition": { "enum": ["polish", "report-only", "handoff"] },
          "status": {
            "enum": [
              "applied",
              "no-change",
              "stale",
              "rejected",
              "failed",
              "inconclusive",
              "handed-off",
              "reported",
              "pending"
            ]
          },
          "completionDigest": {
            "oneOf": [
              { "$ref": "#/$defs/digest" },
              { "type": "null" }
            ]
          },
          "gaps": { "$ref": "#/$defs/textList" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "assessment", "remainingGaps"],
      "properties": {
        "state": { "enum": ["complete", "incomplete", "cancelled"] },
        "assessment": { "$ref": "#/$defs/text" },
        "remainingGaps": { "$ref": "#/$defs/textList" }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "\\S"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "textList": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/text" }
    }
  }
}
