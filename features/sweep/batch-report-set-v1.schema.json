{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hope.local/schemas/sweep/batch-report-set-v1.schema.json",
  "title": "Hope sweep subagent batch report set version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature", "version", "runId", "inventoryDigest", "capabilityDigest", "manifest", "modeSelection", "crossBatchSynthesis", "reports", "attempts", "digest"],
  "properties": {
    "feature": { "const": "sweep-batch-report-set" },
    "version": { "const": 1 },
    "runId": { "$ref": "#/$defs/text" },
    "inventoryDigest": { "$ref": "#/$defs/digest" },
    "capabilityDigest": { "$ref": "#/$defs/digest" },
    "manifest": { "$ref": "#/$defs/manifest" },
    "modeSelection": { "$ref": "#/$defs/modeSelection" },
    "crossBatchSynthesis": { "$ref": "#/$defs/crossBatchSynthesis" },
    "reports": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": { "$ref": "batch-report-v1.schema.json" }
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/attempt" }
    },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/id" }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "fileSourceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "fileSourceIds": { "allOf": [{ "$ref": "#/$defs/sourceIds" }, { "minItems": 1 }] }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch", "manifestDigest", "attempt", "attemptId", "status", "inputDigest", "invocationId", "outputDigest"],
      "properties": {
        "batch": { "$ref": "#/$defs/batch" },
        "manifestDigest": { "$ref": "#/$defs/digest" },
        "attempt": { "type": "integer", "minimum": 1 },
        "attemptId": { "$ref": "#/$defs/digest" },
        "status": { "enum": ["succeeded", "failed", "cancelled"] },
        "inputDigest": { "$ref": "#/$defs/digest" },
        "invocationId": { "$ref": "#/$defs/text" },
        "outputDigest": { "$ref": "#/$defs/digest" },
        "error": { "$ref": "#/$defs/text" }
      }
    },
    "crossBatchSynthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "version", "runId", "inventoryDigest", "capabilityDigest", "manifestDigest", "modeSelectionDigest", "reportSetInputDigest", "mergeInputDigest", "attemptsDigest", "inputDigest", "producerId", "attempt", "attemptId", "invocationId", "outputDigest", "inspection", "evidenceSourceIds", "relationships", "gaps", "digest"],
      "properties": {
        "feature": { "const": "sweep-cross-batch-synthesis" },
        "version": { "const": 1 },
        "runId": { "$ref": "#/$defs/text" },
        "inventoryDigest": { "$ref": "#/$defs/digest" },
        "capabilityDigest": { "$ref": "#/$defs/digest" },
        "manifestDigest": { "$ref": "#/$defs/digest" },
        "modeSelectionDigest": { "$ref": "#/$defs/digest" },
        "reportSetInputDigest": { "$ref": "#/$defs/digest" },
        "mergeInputDigest": { "$ref": "#/$defs/digest" },
        "attemptsDigest": { "$ref": "#/$defs/digest" },
        "inputDigest": { "$ref": "#/$defs/digest" },
        "producerId": { "$ref": "#/$defs/text" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 4 },
        "attemptId": { "$ref": "#/$defs/digest" },
        "invocationId": { "$ref": "#/$defs/text" },
        "outputDigest": { "$ref": "#/$defs/digest" },
        "inspection": { "enum": ["checked", "partial", "not-checked", "failed"] },
        "evidenceSourceIds": { "$ref": "#/$defs/sourceIds" },
        "relationships": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/relationship" } },
        "gaps": { "$ref": "#/$defs/textList" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceIds", "status", "summary", "evidenceSourceIds", "gaps"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sourceIds": { "allOf": [{ "$ref": "#/$defs/sourceIds" }, { "minItems": 2 }] },
        "status": { "enum": ["observed", "unresolved"] },
        "summary": { "$ref": "#/$defs/text" },
        "evidenceSourceIds": { "$ref": "#/$defs/sourceIds" },
        "gaps": { "$ref": "#/$defs/textList" }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "version", "runId", "inventoryDigest", "capabilityDigest", "batches", "invocationId", "digest"],
      "properties": {
        "feature": { "const": "sweep-batch-manifest" },
        "version": { "const": 1 },
        "runId": { "$ref": "#/$defs/text" },
        "inventoryDigest": { "$ref": "#/$defs/digest" },
        "capabilityDigest": { "$ref": "#/$defs/digest" },
        "batches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/batch" }
        },
        "invocationId": { "$ref": "#/$defs/text" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "modeSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "version", "requestedMode", "mode", "fallbackUsed", "selectionDigest", "runId", "inventoryDigest", "capabilityDigest", "manifestDigest", "invocationId", "digest"],
      "properties": {
        "feature": { "const": "sweep-batch-mode-selection" },
        "version": { "const": 1 },
        "requestedMode": { "const": "subagent-hybrid" },
        "mode": { "const": "subagent-hybrid" },
        "fallbackUsed": { "const": false },
        "selectionDigest": { "$ref": "#/$defs/digest" },
        "runId": { "$ref": "#/$defs/text" },
        "inventoryDigest": { "$ref": "#/$defs/digest" },
        "capabilityDigest": { "$ref": "#/$defs/digest" },
        "manifestDigest": { "$ref": "#/$defs/digest" },
        "invocationId": { "$ref": "#/$defs/text" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
