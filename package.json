{
  "name": "hope",
  "version": "3.0.2",
  "private": true,
  "type": "module",
  "description": "Hope plugin source and release tooling for AI-assisted work.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:plugin": "node tools/build-plugin.mjs",
    "check:title": "node tools/check-change-title.mjs",
    "check:readme-assets": "node tools/render-readme-assets.mjs --check",
    "plugin:dev:install": "node tools/install-plugin-dev.mjs",
    "render:readme-assets": "node tools/render-readme-assets.mjs",
    "release:check": "node tools/release-impact.mjs",
    "release:prepare": "node tools/prepare-release.mjs",
    "test": "node --test",
    "test:browser": "playwright test",
    "check:release": "node tools/check-release.mjs",
    "check": "npm run check:release && npm run release:check && npm test"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
