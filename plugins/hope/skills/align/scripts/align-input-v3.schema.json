{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dkstm95/hope/main/plugins/hope/skills/align/scripts/align-input-v3.schema.json",
  "title": "Hope Align artifact input v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "goal",
    "problem",
    "intent",
    "exclusions",
    "revisionSummary"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "locale": { "enum": ["en-US", "ko-KR"] },
    "theme": { "enum": ["system", "light", "dark"] },
    "title": { "$ref": "#/$defs/title" },
    "goal": { "$ref": "#/$defs/citedProse" },
    "problem": { "$ref": "#/$defs/citedProse" },
    "intent": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "verify", "by"],
        "properties": {
          "statement": { "$ref": "#/$defs/citedProse" },
          "verify": { "$ref": "#/$defs/prose" },
          "by": { "enum": ["agent", "human"] },
          "reason": { "$ref": "#/$defs/citedProse" }
        }
      }
    },
    "exclusions": { "$ref": "#/$defs/citedProseList" },
    "designDirections": { "$ref": "#/$defs/designDirections" },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "outcomes"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/titledItem" }
        },
        "outcomes": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/outcomeItem" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "location"],
        "properties": {
          "id": { "$ref": "#/$defs/evidenceId" },
          "label": { "$ref": "#/$defs/title" },
          "location": { "$ref": "#/$defs/prose" }
        }
      }
    },
    "revisionSummary": { "$ref": "#/$defs/prose" }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069]+$"
    },
    "title": {
      "allOf": [
        { "$ref": "#/$defs/text" },
        { "maxLength": 160 }
      ]
    },
    "prose": {
      "allOf": [
        { "$ref": "#/$defs/text" },
        { "maxLength": 4000 }
      ]
    },
    "citedTitle": {
      "oneOf": [
        { "$ref": "#/$defs/title" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "evidenceIds"],
          "properties": {
            "text": { "$ref": "#/$defs/title" },
            "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
          }
        }
      ]
    },
    "citedProse": {
      "oneOf": [
        { "$ref": "#/$defs/prose" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "evidenceIds"],
          "properties": {
            "text": { "$ref": "#/$defs/prose" },
            "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
          }
        }
      ]
    },
    "citedProseList": {
      "type": "array",
      "maxItems": 30,
      "items": { "$ref": "#/$defs/citedProse" }
    },
    "shortProseList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/prose" }
    },
    "optionId": {
      "allOf": [
        { "$ref": "#/$defs/text" },
        { "maxLength": 48 },
        { "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" }
      ]
    },
    "evidenceId": {
      "allOf": [
        { "$ref": "#/$defs/text" },
        { "maxLength": 48 },
        { "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" }
      ]
    },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidenceId" }
    },
    "designDirections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["options", "recommendation", "selection"],
      "properties": {
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/designDirection" }
        },
        "recommendation": { "$ref": "#/$defs/directionDecision" },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["optionId", "reason", "decidedBy"],
          "properties": {
            "optionId": { "$ref": "#/$defs/optionId" },
            "reason": { "$ref": "#/$defs/prose" },
            "decidedBy": { "enum": ["user", "delegated"] }
          }
        }
      }
    },
    "designDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "imagePath",
        "alt",
        "summary",
        "strengths",
        "tradeoffs",
        "references"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/optionId" },
        "title": { "$ref": "#/$defs/title" },
        "imagePath": { "$ref": "#/$defs/absolutePath" },
        "alt": { "$ref": "#/$defs/prose" },
        "summary": { "$ref": "#/$defs/prose" },
        "strengths": { "$ref": "#/$defs/shortProseList" },
        "tradeoffs": { "$ref": "#/$defs/shortProseList" },
        "references": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/designReference" }
        }
      }
    },
    "directionDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optionId", "reason"],
      "properties": {
        "optionId": { "$ref": "#/$defs/optionId" },
        "reason": { "$ref": "#/$defs/prose" }
      }
    },
    "designReference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidenceId", "influence"],
          "properties": {
            "evidenceId": { "$ref": "#/$defs/evidenceId" },
            "influence": { "$ref": "#/$defs/prose" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "url", "influence"],
          "properties": {
            "label": { "$ref": "#/$defs/title" },
            "url": {
              "allOf": [
                { "$ref": "#/$defs/prose" },
                { "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#@]+(?:[/?#]|$)" }
              ]
            },
            "influence": { "$ref": "#/$defs/prose" }
          }
        }
      ]
    },
    "absolutePath": {
      "$comment": "The runtime also requires the path to be absolute on the current platform.",
      "allOf": [
        { "$ref": "#/$defs/prose" },
        { "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\)" }
      ]
    },
    "titledItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "$ref": "#/$defs/citedTitle" },
        "detail": { "$ref": "#/$defs/citedProse" }
      }
    },
    "outcomeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "$ref": "#/$defs/citedTitle" },
        "detail": { "$ref": "#/$defs/citedProse" },
        "kind": { "enum": ["complete", "cancel"] }
      }
    }
  }
}
