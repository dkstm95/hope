{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dkstm95/hope/main/plugins/hope/skills/align/scripts/align-input-v3.schema.json",
  "title": "Hope Align artifact input v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "goal",
    "problem",
    "intent",
    "exclusions",
    "revisionSummary"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "locale": { "enum": ["en-US", "ko-KR"] },
    "theme": { "enum": ["system", "light", "dark"] },
    "title": { "$ref": "align-input-v2.schema.json#/$defs/title" },
    "goal": { "$ref": "align-input-v2.schema.json#/$defs/citedProse" },
    "problem": { "$ref": "align-input-v2.schema.json#/$defs/citedProse" },
    "intent": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "verify", "by"],
        "properties": {
          "statement": { "$ref": "align-input-v2.schema.json#/$defs/citedProse" },
          "verify": { "$ref": "align-input-v2.schema.json#/$defs/prose" },
          "by": { "enum": ["agent", "human"] },
          "reason": { "$ref": "align-input-v2.schema.json#/$defs/citedProse" }
        }
      }
    },
    "exclusions": { "$ref": "align-input-v2.schema.json#/$defs/citedProseList" },
    "designDirections": { "$ref": "align-input-v2.schema.json#/$defs/designDirections" },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "outcomes"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "$ref": "align-input-v2.schema.json#/$defs/titledItem" }
        },
        "outcomes": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "align-input-v2.schema.json#/$defs/outcomeItem" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "location"],
        "properties": {
          "id": { "$ref": "align-input-v2.schema.json#/$defs/evidenceId" },
          "label": { "$ref": "align-input-v2.schema.json#/$defs/title" },
          "location": { "$ref": "align-input-v2.schema.json#/$defs/prose" }
        }
      }
    },
    "revisionSummary": { "$ref": "align-input-v2.schema.json#/$defs/prose" }
  }
}
