{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dkstm95/hope/main/plugins/hope/skills/align/scripts/align-input-v1.schema.json",
  "title": "Hope Align artifact input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "intent",
    "problem",
    "success",
    "boundary",
    "scope",
    "decisions",
    "openChoices",
    "revisionSummary"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "locale": { "enum": ["en-US", "ko-KR"] },
    "theme": { "enum": ["system", "light", "dark"] },
    "title": { "$ref": "#/$defs/title" },
    "intent": { "$ref": "#/$defs/prose" },
    "problem": { "$ref": "#/$defs/prose" },
    "success": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/prose" }
    },
    "boundary": { "$ref": "#/$defs/prose" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded"],
      "properties": {
        "included": { "$ref": "#/$defs/proseList" },
        "excluded": { "$ref": "#/$defs/proseList" }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "outcomes"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/titledItem" }
        },
        "outcomes": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/outcomeItem" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision", "reason"],
        "properties": {
          "decision": { "$ref": "#/$defs/title" },
          "reason": { "$ref": "#/$defs/prose" }
        }
      }
    },
    "openChoices": { "$ref": "#/$defs/proseList" },
    "evidence": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "location"],
        "properties": {
          "label": { "$ref": "#/$defs/title" },
          "location": { "$ref": "#/$defs/prose" }
        }
      }
    },
    "revisionSummary": { "$ref": "#/$defs/prose" }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]+$"
    },
    "title": {
      "allOf": [
        { "$ref": "#/$defs/text" },
        { "maxLength": 160 }
      ]
    },
    "prose": {
      "allOf": [
        { "$ref": "#/$defs/text" },
        { "maxLength": 4000 }
      ]
    },
    "proseList": {
      "type": "array",
      "maxItems": 30,
      "items": { "$ref": "#/$defs/prose" }
    },
    "titledItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "$ref": "#/$defs/title" },
        "detail": { "$ref": "#/$defs/prose" }
      }
    },
    "outcomeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "$ref": "#/$defs/title" },
        "detail": { "$ref": "#/$defs/prose" },
        "kind": { "enum": ["complete", "cancel"] }
      }
    }
  }
}
