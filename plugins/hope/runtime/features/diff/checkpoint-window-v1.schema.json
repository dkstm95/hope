{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hope.local/schemas/diff-checkpoint-window-v1.json",
  "title": "Hope diff checkpoint window v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "snapshotDigest",
    "generation",
    "startPage",
    "endPage",
    "checkpoints"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "snapshotDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generation": { "type": "integer", "minimum": 1 },
    "startPage": { "type": "integer", "minimum": 1 },
    "endPage": { "type": "integer", "minimum": 1 },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "observations"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "observations": {
            "type": "array",
            "maxItems": 8,
            "description": "Page-local facts, risks, and open questions. Use an empty array when the page adds no semantic information.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "text",
                "basis",
                "evidence",
                "contextRequests"
              ],
              "properties": {
                "kind": { "enum": ["fact", "risk", "question"] },
                "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
                "basis": { "enum": ["stated", "code", "inferred"] },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["sourceId", "startLine", "endLine"],
                    "properties": {
                      "sourceId": { "type": "string", "pattern": "^source-[1-9][0-9]*$" },
                      "startLine": { "type": "integer", "minimum": 1 },
                      "endLine": { "type": "integer", "minimum": 1 }
                    }
                  }
                },
                "contextRequests": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "revision"],
                    "properties": {
                      "path": { "type": "string", "minLength": 1 },
                      "revision": { "enum": ["head", "merge-base"] }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
