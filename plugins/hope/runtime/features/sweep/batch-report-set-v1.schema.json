{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hope.local/schemas/sweep/batch-report-set-v1.schema.json",
  "title": "Hope sweep subagent batch report set version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature", "version", "runId", "inventoryDigest", "capabilityDigest", "manifest", "reports", "attempts", "digest"],
  "properties": {
    "feature": { "const": "sweep-batch-report-set" },
    "version": { "const": 1 },
    "runId": { "$ref": "#/$defs/text" },
    "inventoryDigest": { "$ref": "#/$defs/digest" },
    "capabilityDigest": { "$ref": "#/$defs/digest" },
    "manifest": { "$ref": "#/$defs/manifest" },
    "reports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "batch-report-v1.schema.json" }
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/attempt" }
    },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/id" }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "fileSourceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "fileSourceIds": { "allOf": [{ "$ref": "#/$defs/sourceIds" }, { "minItems": 1 }] }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch", "attempt", "attemptId", "status", "inputDigest", "invocationId"],
      "properties": {
        "batch": { "$ref": "#/$defs/batch" },
        "attempt": { "type": "integer", "minimum": 1 },
        "attemptId": { "$ref": "#/$defs/digest" },
        "status": { "enum": ["succeeded", "failed", "cancelled"] },
        "inputDigest": { "$ref": "#/$defs/digest" },
        "invocationId": { "$ref": "#/$defs/text" },
        "error": { "$ref": "#/$defs/text" }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "version", "runId", "inventoryDigest", "capabilityDigest", "batches", "invocationId", "digest"],
      "properties": {
        "feature": { "const": "sweep-batch-manifest" },
        "version": { "const": 1 },
        "runId": { "$ref": "#/$defs/text" },
        "inventoryDigest": { "$ref": "#/$defs/digest" },
        "capabilityDigest": { "$ref": "#/$defs/digest" },
        "batches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/batch" }
        },
        "invocationId": { "$ref": "#/$defs/text" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
