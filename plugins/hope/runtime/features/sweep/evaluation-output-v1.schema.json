{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hope.local/schemas/sweep/evaluation-output-v1.schema.json",
  "title": "Hope sweep model-evaluation output version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "categoryId",
    "checkId",
    "decision",
    "impacts",
    "targetPaths",
    "unsupportedCategoryIds",
    "reason"
  ],
  "properties": {
    "categoryId": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "checkId": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "decision": {
      "enum": ["polish", "report-only", "handoff", "no-candidate"]
    },
    "impacts": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["behavior", "publicContract", "dependency"],
      "properties": {
        "behavior": {
          "enum": ["preserving", "changing", "uncertain"]
        },
        "publicContract": {
          "enum": ["preserving", "changing", "uncertain"]
        },
        "dependency": {
          "enum": ["preserving", "changing", "uncertain"]
        }
      }
    },
    "targetPaths": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "\\S"
      }
    },
    "unsupportedCategoryIds": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    }
  }
}
