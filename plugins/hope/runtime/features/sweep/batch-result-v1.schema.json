{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hope.local/schemas/sweep/batch-result-v1.schema.json",
  "title": "Hope sweep batch result version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batchId",
    "inventoryDigest",
    "inputDigest",
    "state",
    "execution",
    "workerReports",
    "workerReportsDigest"
  ],
  "properties": {
    "batchId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "inventoryDigest": { "pattern": "^sha256:[a-f0-9]{64}$" },
    "inputDigest": { "pattern": "^sha256:[a-f0-9]{64}$" },
    "state": { "enum": ["complete", "partial", "failed"] },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "workerIds"],
      "properties": {
        "mode": { "enum": ["single", "parallel", "sequential"] },
        "workerIds": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        }
      }
    },
    "workerReports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workerId", "processedSourceIds", "gaps"],
        "properties": {
          "workerId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "processedSourceIds": {
            "type": "array",
            "maxItems": 127,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          },
          "gaps": {
            "type": "array",
            "maxItems": 64,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "workerReportsDigest": { "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
