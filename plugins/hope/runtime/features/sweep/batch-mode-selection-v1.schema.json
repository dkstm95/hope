{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hope.local/schemas/sweep/batch-mode-selection-v1.schema.json",
  "title": "Hope sweep subagent hybrid mode selection version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature", "version", "requestedMode", "mode", "fallbackUsed", "runId", "inventoryDigest", "capabilityDigest", "manifestDigest", "invocationId", "digest"],
  "properties": {
    "feature": { "const": "sweep-batch-mode-selection" },
    "version": { "const": 1 },
    "requestedMode": { "const": "subagent-hybrid" },
    "mode": { "const": "subagent-hybrid" },
    "fallbackUsed": { "const": false },
    "runId": { "$ref": "#/$defs/text" },
    "inventoryDigest": { "$ref": "#/$defs/digest" },
    "capabilityDigest": { "$ref": "#/$defs/digest" },
    "manifestDigest": { "$ref": "#/$defs/digest" },
    "invocationId": { "$ref": "#/$defs/text" },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
