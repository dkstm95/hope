{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hope.local/schemas/sweep/inventory-v1.schema.json",
  "title": "Hope sweep inventory version 1",
  "description": "Structural inventory schema. The shared Sweep runtime validates the exact Git and file identities and derives the inventory digest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature", "version", "snapshot", "fileSourceIds", "digest"],
  "properties": {
    "feature": { "const": "sweep-inventory" },
    "version": { "const": 1 },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capturedAt", "sources"],
      "properties": {
        "capturedAt": { "type": "string", "format": "date-time" },
        "sources": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "label", "locator"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "kind": { "enum": ["git", "file"] },
              "label": { "$ref": "#/$defs/text" },
              "locator": { "$ref": "#/$defs/text" },
              "revision": { "$ref": "#/$defs/text" },
              "digest": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    },
    "fileSourceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "\\S"
    }
  }
}
