{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hope.local/schemas/align/session-v2.schema.json",
  "title": "Hope align session version 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "title",
    "taskRisk",
    "ui",
    "revision",
    "interviewRounds",
    "locale",
    "theme",
    "snapshot",
    "understanding",
    "records",
    "assumptions",
    "uncertainties",
    "perspectives",
    "slices",
    "changes",
    "readiness",
    "preview"
  ],
  "properties": {
    "version": { "const": 2 },
    "title": { "$ref": "session-v1.schema.json#/$defs/text" },
    "taskRisk": { "$ref": "session-v1.schema.json#/properties/taskRisk" },
    "ui": { "$ref": "session-v1.schema.json#/properties/ui" },
    "revision": { "$ref": "session-v1.schema.json#/properties/revision" },
    "interviewRounds": { "$ref": "session-v1.schema.json#/properties/interviewRounds" },
    "locale": { "$ref": "session-v1.schema.json#/properties/locale" },
    "theme": { "$ref": "session-v1.schema.json#/properties/theme" },
    "snapshot": { "$ref": "session-v1.schema.json#/$defs/snapshot" },
    "understanding": { "$ref": "session-v1.schema.json#/properties/understanding" },
    "records": { "$ref": "session-v1.schema.json#/properties/records" },
    "assumptions": { "$ref": "session-v1.schema.json#/properties/assumptions" },
    "uncertainties": { "$ref": "session-v1.schema.json#/properties/uncertainties" },
    "perspectives": { "$ref": "session-v1.schema.json#/properties/perspectives" },
    "slices": { "$ref": "session-v1.schema.json#/properties/slices" },
    "changes": { "$ref": "session-v1.schema.json#/properties/changes" },
    "readiness": { "$ref": "session-v1.schema.json#/properties/readiness" },
    "polish": { "$ref": "session-v1.schema.json#/properties/polish" },
    "preview": { "$ref": "#/$defs/preview" }
  },
  "$defs": {
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "rationale",
        "changedAspects",
        "screens",
        "frames"
      ],
      "properties": {
        "disposition": {
          "enum": ["required", "provided", "not-required"]
        },
        "rationale": { "$ref": "session-v1.schema.json#/$defs/text" },
        "changedAspects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "none",
              "copy",
              "layout",
              "visual-hierarchy",
              "component-placement",
              "user-flow",
              "screen-state"
            ]
          }
        },
        "screens": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/previewScreen" }
        },
        "frames": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/previewFrame" }
        }
      }
    },
    "previewScreen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "scenarioId", "state", "root", "annotations"],
      "properties": {
        "id": { "$ref": "session-v1.schema.json#/$defs/id" },
        "label": { "$ref": "session-v1.schema.json#/$defs/text" },
        "scenarioId": { "$ref": "session-v1.schema.json#/$defs/id" },
        "state": { "$ref": "session-v1.schema.json#/$defs/text" },
        "root": { "$ref": "#/$defs/previewNode" },
        "annotations": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/previewAnnotation" }
        }
      }
    },
    "previewFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "viewport", "screenId"],
      "properties": {
        "id": { "$ref": "session-v1.schema.json#/$defs/id" },
        "label": { "$ref": "session-v1.schema.json#/$defs/text" },
        "viewport": { "enum": ["wide", "narrow"] },
        "screenId": { "$ref": "session-v1.schema.json#/$defs/id" }
      }
    },
    "previewAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nodeId", "text"],
      "properties": {
        "id": { "$ref": "session-v1.schema.json#/$defs/id" },
        "nodeId": { "$ref": "session-v1.schema.json#/$defs/id" },
        "text": { "$ref": "session-v1.schema.json#/$defs/text" }
      }
    },
    "previewNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "session-v1.schema.json#/$defs/id" },
        "type": {
          "enum": ["group", "heading", "text", "list", "status", "action", "divider"]
        },
        "label": { "$ref": "session-v1.schema.json#/$defs/text" },
        "text": { "$ref": "session-v1.schema.json#/$defs/text" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "session-v1.schema.json#/$defs/text" }
        },
        "layout": { "enum": ["stack", "row", "grid"] },
        "level": { "type": "integer", "minimum": 1, "maximum": 3 },
        "emphasis": { "enum": ["normal", "strong", "quiet"] },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/previewNode" }
        }
      }
    }
  }
}
