{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hope.local/schemas/toxic-review/run-plan-v1.schema.json",
  "title": "Hope toxic review role-run plan version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "runId",
    "title",
    "risk",
    "target",
    "snapshot",
    "selection",
    "execution"
  ],
  "properties": {
    "version": { "const": 1 },
    "runId": { "$ref": "review-v1.schema.json#/$defs/id" },
    "title": { "$ref": "review-v1.schema.json#/$defs/text" },
    "risk": { "enum": ["low", "medium", "high"] },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "stage", "summary"],
      "properties": {
        "kind": {
          "enum": [
            "idea",
            "requirements",
            "ui",
            "prototype",
            "plan",
            "implementation",
            "patch",
            "pull-request",
            "align",
            "diff",
            "incident",
            "recovery-plan",
            "document",
            "other"
          ]
        },
        "stage": {
          "enum": ["idea", "design", "implementation", "completed", "operation"]
        },
        "summary": { "$ref": "review-v1.schema.json#/$defs/text" }
      }
    },
    "snapshot": { "$ref": "review-v1.schema.json#/$defs/snapshot" },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "maximumRoles", "roles"],
      "properties": {
        "reason": { "$ref": "review-v1.schema.json#/$defs/text" },
        "maximumRoles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/role" }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "independentContexts"],
      "properties": {
        "mode": {
          "enum": ["single", "parallel", "isolated-sequential"]
        },
        "independentContexts": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "target",
        "focusRisks",
        "evidenceSourceIds",
        "excludedAreas",
        "claimsToTest",
        "expectedOutput"
      ],
      "properties": {
        "id": { "$ref": "review-v1.schema.json#/$defs/id" },
        "name": { "$ref": "review-v1.schema.json#/$defs/text" },
        "method": { "enum": ["causal-completeness"] },
        "target": { "$ref": "review-v1.schema.json#/$defs/text" },
        "focusRisks": {
          "allOf": [
            { "$ref": "review-v1.schema.json#/$defs/textList" },
            { "minItems": 1 }
          ]
        },
        "evidenceSourceIds": {
          "allOf": [
            { "$ref": "review-v1.schema.json#/$defs/idList" },
            { "minItems": 1 }
          ]
        },
        "excludedAreas": {
          "$ref": "review-v1.schema.json#/$defs/textList"
        },
        "claimsToTest": {
          "allOf": [
            { "$ref": "review-v1.schema.json#/$defs/textList" },
            { "minItems": 1 }
          ]
        },
        "expectedOutput": { "$ref": "review-v1.schema.json#/$defs/text" }
      }
    }
  }
}
